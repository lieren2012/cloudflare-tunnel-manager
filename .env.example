# 复制为 .env 后按需修改（.env 不会被提交到 git）
# 用法：cp .env.example .env

# ---- 镜像与构建（默认优先使用 GHCR 预构建镜像）----
# CFM_IMAGE=ghcr.io/lieren2012/cloudflare-tunnel-manager:latest
# 本地构建时使用下面两个基础镜像地址；也可替换成你所在网络更快的镜像站。
# 默认：docker.m.daocloud.io
# 海外环境或加速站不可用时，取消注释切回官方源：
# NODE_IMAGE=node:22-alpine
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# 也可换用其他加速站（把域名换成你的）：
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# CLOUDFLARED_IMAGE=docker.m.daocloud.io/cloudflare/cloudflared:latest

# ---- npm 源（构建时安装依赖用）----
# NPM_REGISTRY=https://registry.npmmirror.com

# ---- 容器 ----
TZ=Asia/Shanghai
# 管理面板登录密码；留空则首次启动需要自己注册管理员账号
ADMIN_PASSWORD=
